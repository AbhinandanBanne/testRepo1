{
  "name": "hagrids-playwright",
  "version": "1.0.0",
  "description": "Playwright script: open hagrids.com, scroll down, and play the embedded YouTube video",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:youtube": "playwright test tests/hagrids-youtube.spec.js --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
